---
// Le gabarit unique : en-tête, bouton « Menu », menu (sa vidéo), le contenu de la page,
// et tout ce que la tête doit dire (titre, description, adresse canonique,
// partages, données structurées). Les réglages viennent du CMS, une fois par
// build.
//
// Changement de page : le ClientRouter d'Astro, avec une animation sur la
// racine. L'image de l'ancienne page reste en place, figée, et la nouvelle
// apparaît en fondu par-dessus en 0,7 s : photo sur photo, jamais par le noir
// (voir `fondu` ci-dessous et site.css). Sans l'API View Transitions, le
// repli est `swap` : un remplacement net, plutôt qu'un fondu qui passerait
// par le noir. `prefers-reduced-motion` : Astro coupe l'animation.
//
// Le bouton « Menu » et le menu sont `transition:persist` : la vidéo, une fois
// chargée, ne se recharge pas à chaque page. L'en-tête (logo) est fixe, voilé
// d'une bande noire translucide dès que la page défile.
import { getEntry } from 'astro:content';
import { ClientRouter } from 'astro:transitions';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import logo from '../assets/logo-arc-en-ciel.webp';
import logoBlanc from '../assets/logo-cie-blanc-256.webp';
import { og } from '../lib/images.js';
import type { Réactive } from '../lib/images.js';
import { T } from '../lib/textes.js';
import { tx, typographier } from '../lib/typo.js';
import '../styles/site.css';

interface Props {
  title?: string;
  description?: string | null;
  // L'image des partages de cette page (une affiche, une grande photo).
  image?: ImageMetadata | { src: string; width: number; height: number; format?: string } | null;
  // La photo du haut, préchargée : c'est le premier téléchargement de la page.
  precharger?: Réactive | null;
  // Les données structurées (schema.org), sans le contexte : il est posé ici.
  jsonLd?: Record<string, unknown> | Record<string, unknown>[] | null;
  // Faux pour une page qui n'a pas sa place dans un moteur (la 404).
  indexer?: boolean;
}

const { title, description = null, image = null, precharger = null, jsonLd = null, indexer = true } = Astro.props;

const site = (await getEntry('reglages', 'site'))!.data;

// Le titre de l'onglet suit le prototype : « Page · Compagnie Cliffhanger ».
// L'accueil dit en plus ce qu'est la compagnie, et où : le nom seul ne dit
// rien à qui cherche du théâtre à Bruxelles.
const titrePartage = title ?? `${site.site_title} · ${T.titreAccueil}`;
const titreComplet = tx(title ? `${title} · ${site.site_title}` : titrePartage);
// La description, typographiée comme le titre (Astro échappe l'attribut).
const résumé = typographier(description || site.site_description || T.descriptionParDéfaut);
// Une page hors index n'a pas d'adresse canonique : la 404 est servie à
// toutes les adresses qui n'existent pas.
const canonique = indexer ? new URL(Astro.url.pathname, Astro.site).toString() : null;

// L'image des partages : celle de la page, sinon celle des réglages, sinon
// le fond d'accueil ; rien plutôt qu'une image fausse.
let ogSource = image ?? site.og_image;
if (!ogSource && site.fonds.accueil) ogSource = (await getEntry('photos', site.fonds.accueil))?.data.image ?? null;
const ogUrl = ogSource ? new URL(await og(ogSource), Astro.site).toString() : null;

// Le logo arc-en-ciel du menu, comme la vidéo : chargé en temps mort après la page (data-src),
// pour ne pas concurrencer la photo du haut.
const logoMenu = await getImage({ src: logo, width: 384, format: 'webp' });

// Le logo blanc de l'en-tête, à côté du nom : affiché sur 2,5 rem de haut, rendu au double pour les écrans denses.
const logoEntête = await getImage({ src: logoBlanc, height: 80, format: 'webp' });

// La vidéo et l'affiche du menu viennent des réglages ; vides, les fichiers
// de public/ (ceux d'origine) continuent de servir.
const vidéoMenu = site.menu_video ?? '/menu.mp4';
const afficheMenu = site.menu_poster ? (await getImage({ src: site.menu_poster, width: 1440, format: 'webp' })).src : '/menu-poster.webp';

// Le lien du menu vers la rubrique en cours : la première partie de
// l'adresse, comme le prototype (une fiche spectacle n'allume pas « Spectacles »).
const rubrique = `/${Astro.url.pathname.split('/').filter(Boolean)[0] ?? ''}/`;

// Le préchargement de la photo du haut vise ce que le <picture> choisira :
// l'AVIF (un navigateur qui ne le lit pas ignore le lien et trouve le WebP
// dans la page), et le recadrage portrait sur un écran tenu droit. Les deux
// médias sont complémentaires : un seul lien part.
const préchargements = precharger
  ? [
      precharger.portrait && {
        media: '(orientation: portrait)',
        type: precharger.portrait.avif ? 'image/avif' : undefined,
        srcset: precharger.portrait.avif ?? precharger.portrait.srcset,
        sizes: precharger.portrait.sizes,
      },
      {
        media: precharger.portrait ? '(orientation: landscape)' : undefined,
        type: precharger.avif ? 'image/avif' : undefined,
        srcset: precharger.avif ?? precharger.srcset,
        sizes: precharger.sizes,
      },
    ].filter((p) => !!p)
  : [];

const ld = jsonLd
  ? JSON.stringify(Array.isArray(jsonLd) ? jsonLd.map((o) => ({ '@context': 'https://schema.org', ...o })) : { '@context': 'https://schema.org', ...jsonLd }).replace(
      /</g,
      '\\u003c'
    )
  : null;

// Le fondu de page, posé sur la racine : l'ancienne image reste pleine
// pendant que la nouvelle monte. Les deux durent 0,7 s, pour que l'ancienne
// ne disparaisse pas avant que la nouvelle soit là.
const fondu = {
  old: { name: 'cliffReste', duration: '0.7s', easing: 'linear', fillMode: 'both' },
  new: { name: 'cliffFondu', duration: '0.7s', easing: 'ease', fillMode: 'both' },
};
const animation = { forwards: fondu, backwards: fondu };

// Les trois traits du burger, qui deviennent une croix.
const trait = 'fill-current [transition:translate_.3s_ease,rotate_.3s_ease,opacity_.1s_ease]';
// Les entrées du menu descendent en place l'une après l'autre (--i), et repartent ensemble.
const entrée =
  '-translate-y-3 opacity-0 [transition:opacity_.4s_ease,translate_.5s_var(--ease-cliff)] menu-ouvert:translate-y-0 menu-ouvert:opacity-100 menu-ouvert:delay-[calc(var(--i,0)*50ms)] sans-js:translate-y-0 sans-js:opacity-100';
---

<!doctype html>
<html lang="fr" class="scroll-pt-24" transition:animate={animation} transition:name="root">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#000000" />
    <title set:html={titreComplet} />
    <meta name="description" content={résumé} />
    {canonique && <link rel="canonical" href={canonique} />}
    {/* max-image-preview : les grandes vignettes dans les résultats et Discover. N'autorise rien de plus aux robots d'entraînement. */}
    <meta name="robots" content={indexer ? 'max-image-preview:large' : 'noindex'} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_BE" />
    <meta property="og:site_name" content={site.site_title} />
    <meta property="og:title" content={typographier(titrePartage)} />
    <meta property="og:description" content={résumé} />
    {canonique && <meta property="og:url" content={canonique} />}
    {ogUrl && <meta property="og:image" content={ogUrl} />}
    <meta name="twitter:card" content={ogUrl ? 'summary_large_image' : 'summary'} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href="/fonts/jost-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/archivo-800-latin.woff2" as="font" type="font/woff2" crossorigin />
    {préchargements.map((p) => <link rel="preload" as="image" media={p.media} type={p.type} imagesrcset={p.srcset} imagesizes={p.sizes} fetchpriority="high" />)}
    {site.head_verification && <Fragment set:html={site.head_verification} />}
    {ld && <script type="application/ld+json" set:html={ld} />}
    <script is:inline>
      // Avec JS : le burger remplace la ligne de liens (variante sans-js). Le routeur
      // recopie les attributs de <html> de la page suivante, qui n'a pas la
      // classe : on la remet après chaque changement.
      document.documentElement.classList.add('js');
      if (!window.__cliffJs) {
        window.__cliffJs = true;
        document.addEventListener('astro:after-swap', () => document.documentElement.classList.add('js'));
      }
    </script>
    <ClientRouter fallback="swap" />
  </head>
  <body class="menu-ouvert:overflow-hidden">
    <a class="fixed -top-16 left-4 z-60 bg-front px-4 py-3 font-normal text-back transition-[top] duration-200 focus:top-[calc(1rem+var(--safe-top))]" href="#contenu">{T.allerAuContenu}</a>
    {/* La barre de chargement : un trait blanc en haut de l'écran, allumé par le script (data-actif) quand une page tarde. Elle survit au changement de page, comme le menu : le routeur recopie les attributs de <html>, pas ceux d'un élément gardé. Sans mouvement (prefers-reduced-motion), le trait reste plein le temps de l'attente. */}
    <div class="js-chargement pointer-events-none fixed inset-x-0 top-0 z-50 h-0.5 origin-left bg-front opacity-0 transition-opacity duration-200 data-actif:animate-chargement data-actif:opacity-100" aria-hidden="true" transition:persist="chargement"></div>
    <header class="js-entete group pointer-events-none fixed inset-x-0 top-0 z-20 pt-[calc(1rem+var(--safe-top))] pr-4 pb-4 pl-gouttiere sans-js:absolute">
      {/* Le voile : une bande noire translucide qui n'apparaît qu'une fois la page défilée, pour que le logo et « Menu » restent lisibles sur une photo. */}
      <div class="absolute inset-0 -z-1 bg-back/60 backdrop-blur-sm opacity-0 transition-opacity duration-250 group-[.est-parti]:opacity-100" aria-hidden="true"></div>
      <a
        href="/"
        class="pointer-events-auto inline-flex max-w-64 items-center gap-2.5 text-2xl leading-[1.2] tracking-large uppercase opacity-75 transition-opacity duration-250 ease-linear hover:opacity-100 focus-visible:opacity-100"
        translate="no"
      >
        {/* Le logo, décoratif : le nom de la compagnie, juste à côté, dit déjà où mène le lien. */}
        <img class="h-10 w-auto shrink-0" src={logoEntête.src} width={logoEntête.attributes.width} height={logoEntête.attributes.height} alt="" />
        <span set:html={tx(site.site_title)} />
      </a>
    </header>
    <button
      class="fixed top-[calc(.375rem+var(--safe-top))] right-1.5 z-40 flex h-11 items-center gap-3 px-3 opacity-75 transition-opacity duration-250 ease-linear hover:opacity-100 focus-visible:opacity-100 lg:right-[calc(var(--spacing-gouttiere)-.75rem)] sans-js:hidden"
      id="burger"
      aria-expanded="false"
      aria-controls="menu"
      transition:persist="burger"
    >
      <span class="text-sm tracking-large uppercase">{T.menuBouton}</span>
      {/* Les traits pivotent autour de leur bout gauche : le haut et le bas se croisent en X, celui du milieu s'efface. */}
      <svg class="block size-6" viewBox="0 0 32 32" aria-hidden="true">
        <rect class={`${trait} origin-[2px_6px] menu-ouvert:translate-x-[4px] menu-ouvert:rotate-45`} y="4" width="32" height="4"></rect>
        <rect class={`${trait} menu-ouvert:opacity-0`} y="14" width="32" height="4"></rect>
        <rect class={`${trait} origin-[2px_26px] menu-ouvert:translate-x-[4px] menu-ouvert:-rotate-45`} y="24" width="32" height="4"></rect>
      </svg>
    </button>
    <nav
      class:list={[
        'fixed inset-0 z-30 isolate flex items-center justify-center overscroll-contain bg-back px-4 py-8',
        'invisible opacity-0 [transition:opacity_.25s_linear,visibility_.25s_linear]',
        // À l'ouverture, visible tout de suite (le fondu reste celui de l'opacité) : pendant la
        // transition depuis hidden, le premier lien n'était pas encore focalisable.
        'menu-ouvert:visible menu-ouvert:opacity-100 menu-ouvert:[transition:opacity_.25s_linear,visibility_0s]',
        // Sans JS, pas de burger : le menu devient une ligne de liens sous le logo, pour que chaque
        // page reste atteignable.
        'sans-js:visible sans-js:relative sans-js:inset-auto sans-js:z-25 sans-js:block sans-js:bg-transparent sans-js:px-gouttiere sans-js:pt-[calc(5rem+var(--safe-top))] sans-js:pb-0 sans-js:opacity-100',
      ]}
      id="menu"
      aria-label={T.menuPrincipal}
      transition:persist="menu"
    >
      <video
        class="pointer-events-none absolute inset-0 -z-1 size-full object-cover brightness-40 sans-js:hidden"
        id="menuVideo"
        muted
        loop
        playsinline
        preload="none"
        data-poster={afficheMenu}
        aria-hidden="true"
      >
        <source src={vidéoMenu} type="video/mp4" />
      </video>
      <ul class="relative grid gap-2 text-center text-2xl font-normal sans-js:flex sans-js:flex-wrap sans-js:justify-start sans-js:gap-x-1 sans-js:gap-y-0 sans-js:text-left sans-js:text-base">
        {/* Le logo se charge en temps mort, par le script : sans JS, il n'a pas lieu d'être. */}
        <li class={`${entrée} sans-js:hidden`} style="--i:0" aria-hidden="true">
          <img class="mx-auto mb-[clamp(1.5rem,5vh,3rem)] h-auto w-[clamp(7rem,22vh,12rem)]" data-src={logoMenu.src} alt="" width="384" height="384" />
        </li>
        {
          T.menu.map((l, i) => (
            <li class={entrée} style={`--i:${i + 1}`}>
              <a
                class="inline-block px-3 py-1 opacity-75 transition-opacity duration-250 hover:opacity-100 focus-visible:opacity-100 aria-[current=page]:opacity-100 data-en-cours:opacity-100 sans-js:pl-0"
                href={l.href}
                aria-current={l.href === rubrique ? 'page' : undefined}
                set:html={tx(l.label)}
              />
            </li>
          ))
        }
      </ul>
    </nav>

    <main id="contenu" tabindex="-1">
      <slot />
    </main>

    {/* La cascade part ici, avant la première peinture : posée par le module (téléchargé après la photo et les polices), elle effaçait des blocs déjà affichés pour les refaire monter. Sans mouvement réduit seulement ; sans JS, rien n'est caché. */}
    <script is:inline>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        /** @type {NodeListOf<HTMLElement>} */
        var blocs = document.querySelectorAll('main [data-cascade]:not(.animate-rise)');
        blocs.forEach(function (el, i) {
          el.classList.add('animate-rise');
          el.style.animationDelay = Math.min(0.1 + i * 0.07, 0.9) + 's';
        });
      }
    </script>

    <script>
      // Les comportements communs à toutes les pages. Ce module ne s'exécute
      // qu'une fois (le routeur ne recharge pas la page) : ce qui dépend de la
      // page en cours se relance sur `astro:page-load`, le reste passe par des
      // écouteurs délégués sur le document, qui survivent aux changements.
      const mouvementRéduit = matchMedia('(prefers-reduced-motion: reduce)');
      const burger = () => document.getElementById('burger');
      const menu = () => document.getElementById('menu');

      // --- Le menu -----------------------------------------------------------
      // Le logo, l'affiche et le début de la vidéo partent en temps mort après le chargement (ou
      // dès que la main approche du bouton), pour être là à l'ouverture : chargés au clic, le logo
      // surgissait après les liens et la vidéo démarrait en retard.
      const connexion = () => (navigator as Navigator & { connection?: { saveData?: boolean; effectiveType?: string } }).connection;
      // `approche` : la main est sur le bouton, la vidéo part quelle que soit la connexion. Au repos,
      // elle ne part que sur une connexion rapide connue (4g) : les autres ne paient pas cinq mégaoctets
      // pour un menu qu'elles n'ouvriront peut-être pas.
      function préparerMenu(approche = true) {
        const m = menu();
        const vidéo = document.getElementById('menuVideo') as HTMLVideoElement | null;
        m?.querySelectorAll<HTMLImageElement>('img[data-src]').forEach((i) => {
          i.src = i.dataset.src!;
          i.removeAttribute('data-src');
        });
        if (!vidéo) return;
        if (vidéo.dataset.poster) {
          vidéo.poster = vidéo.dataset.poster;
          delete vidéo.dataset.poster;
        }
        // Avec l'économiseur de données ou le mouvement réduit, l'image fixe suffit : rien d'avance.
        const permis = !mouvementRéduit.matches && connexion()?.saveData !== true && (approche || connexion()?.effectiveType === '4g');
        if (permis && vidéo.preload !== 'auto') vidéo.preload = 'auto';
      }
      const auRepos = (f: () => void) => ('requestIdleCallback' in window ? requestIdleCallback(f) : setTimeout(f, 1000));
      const auReposMenu = () => auRepos(() => préparerMenu(false));
      if (document.readyState === 'complete') auReposMenu();
      else addEventListener('load', auReposMenu, { once: true });
      for (const type of ['pointerenter', 'focusin', 'touchstart']) {
        document.addEventListener(type, (e) => (e.target as Element).closest?.('#burger') && préparerMenu(), { capture: true, passive: true });
      }

      function ouvrirMenu(ouvert: boolean) {
        const b = burger();
        const m = menu();
        const vidéo = document.getElementById('menuVideo') as HTMLVideoElement | null;
        if (!b || !m || !vidéo) return;
        document.body.classList.toggle('menu-open', ouvert);
        b.setAttribute('aria-expanded', String(ouvert));
        // Le menu couvre l'écran : ce qu'il cache n'est ni lu ni atteignable (le logo et la page).
        document.querySelectorAll<HTMLElement>('body > header, main').forEach((n) => (n.inert = ouvert));
        if (ouvert) {
          // Filet : tout part déjà au repos, ceci ne sert qu'à un clic avant la fin du chargement.
          préparerMenu();
          if (!mouvementRéduit.matches && connexion()?.saveData !== true) vidéo.play().catch(() => {});
          m.querySelector('a')?.focus({ preventScroll: true });
        } else {
          setTimeout(() => {
            if (!document.body.classList.contains('menu-open')) vidéo.pause();
          }, 300);
        }
      }
      const menuOuvert = () => document.body.classList.contains('menu-open');

      document.addEventListener('click', (e) => {
        const cible = e.target as Element;
        if (cible.closest('#burger')) {
          const ouvrir = !menuOuvert();
          ouvrirMenu(ouvrir);
          if (!ouvrir) burger()?.focus();
        } else if (cible.closest('#menu a')) {
          // Vers une autre page, le menu reste ouvert : `astro:before-swap` le ferme à l'arrivée
          // de la page. Le fermer ici montrerait l'ancienne page pendant le chargement. Un lien
          // vers la page déjà affichée ne change rien : on ferme tout de suite.
          const lien = cible.closest('a') as HTMLAnchorElement;
          if (lien.pathname === location.pathname || lien.target === '_blank') ouvrirMenu(false);
        }
      });

      // Tab reste dans le menu ouvert ; Échap le ferme.
      document.addEventListener('keydown', (e) => {
        if (!menuOuvert()) return;
        if (e.key === 'Escape') {
          ouvrirMenu(false);
          burger()?.focus();
        } else if (e.key === 'Tab') {
          const cibles = [burger(), ...(menu()?.querySelectorAll('a') ?? [])].filter((n): n is HTMLElement => !!n && n.getClientRects().length > 0);
          const premier = cibles[0];
          const dernier = cibles[cibles.length - 1];
          if (e.shiftKey && document.activeElement === premier) {
            e.preventDefault();
            dernier?.focus();
          } else if (!e.shiftKey && document.activeElement === dernier) {
            e.preventDefault();
            premier?.focus();
          }
        }
      });

      // Le burger et le menu survivent au changement de page : on les remet
      // fermés, et l'on rallume le lien de la nouvelle rubrique.
      document.addEventListener('astro:before-swap', () => ouvrirMenu(false));
      document.addEventListener('astro:page-load', () => {
        const rubrique = `/${location.pathname.split('/').filter(Boolean)[0] ?? ''}/`;
        menu()
          ?.querySelectorAll('a')
          .forEach((a) => {
            if (a.getAttribute('href') === rubrique) a.setAttribute('aria-current', 'page');
            else a.removeAttribute('aria-current');
          });
      });

      // --- Pages préchargées -----------------------------------------------------
      // Le routeur retélécharge la page à chaque clic : il ne réutilise pas le préchargement d'Astro,
      // et l'hébergeur coupe la connexion après quelques secondes d'inactivité (une poignée de main
      // TLS de plus, ~500 ms). Les pages sont donc gardées en mémoire, prises à l'approche de la main
      // ou au repos, et le chargeur du routeur les lit ici avant de se rabattre sur le sien.
      type Entrée = { quand: number; html: Promise<string | null>; photo?: boolean };
      const pages = new Map<string, Entrée>();
      // Courte : la reconstruction de la nuit efface les anciens fichiers à empreinte.
      const duréePage = 2 * 60_000;
      const frais = (e?: Entrée): e is Entrée => !!e && Date.now() - e.quand < duréePage;

      // Un lien vers une autre page du site, en adresse finale (barre oblique : sans elle, Apache redirige).
      function lienInterne(cible: Element | null) {
        const l = cible?.closest?.('a[href]') as HTMLAnchorElement | null | undefined;
        if (!l || l.origin !== location.origin || l.target || l.hasAttribute('download') || l.hasAttribute('data-astro-reload')) return null;
        if (!l.pathname.endsWith('/') || (l.pathname === location.pathname && l.search === location.search)) return null;
        return l;
      }

      function précharger(l: HTMLAnchorElement) {
        const url = l.origin + l.pathname + l.search;
        const déjà = pages.get(url);
        if (frais(déjà)) return déjà;
        const entrée: Entrée = {
          quand: Date.now(),
          html: fetch(url)
            // Une redirection (r.url ≠ url) mettrait la mauvaise adresse dans l'historique.
            .then((r) => (r.ok && r.url === url && r.headers.get('content-type')?.includes('text/html') ? r.text() : null))
            .catch(() => null),
        };
        pages.set(url, entrée);
        entrée.html.then((h) => h === null && pages.get(url) === entrée && pages.delete(url));
        return entrée;
      }

      // La photo du haut de la page reçue, la même que celle que son <picture> choisira (le
      // préchargement de sa tête la désigne) : sans cela elle ne part qu'après le changement de page,
      // et c'est elle qu'on attend (~500 ms), page déjà là.
      function chaufferPhoto(entrée: Entrée, html: string) {
        if (entrée.photo) return;
        entrée.photo = true;
        const doc = new DOMParser().parseFromString(html, 'text/html');
        const lien = [...doc.querySelectorAll('link[rel=preload][as=image]')].find((p) => {
          const media = p.getAttribute('media');
          return !media || matchMedia(media).matches;
        });
        if (!lien) return;
        const img = new Image();
        img.fetchPriority = 'low';
        img.sizes = lien.getAttribute('imagesizes') ?? '';
        img.srcset = lien.getAttribute('imagesrcset') ?? '';
      }

      // La main approche d'un lien : sa page part tout de suite (et rouvre la connexion avant le clic),
      // puis sa photo du haut. Le repos, lui, ne prend que les pages : pas de photos pour des liens
      // que personne n'a approchés.
      for (const type of ['pointerenter', 'focusin', 'touchstart']) {
        document.addEventListener(
          type,
          (e) => {
            const l = lienInterne(e.target as Element);
            if (!l) return;
            const entrée = précharger(l);
            if (connexion()?.saveData !== true) entrée.html.then((h) => h && chaufferPhoto(entrée, h));
          },
          { capture: true, passive: true }
        );
      }

      // Au repos : les liens du menu, et ceux de la page une fois à l'écran (sur téléphone, pas de survol).
      // Le reste ne part que sur une connexion rapide connue, comme la vidéo du menu.
      const visibles =
        'IntersectionObserver' in window
          ? new IntersectionObserver((entrées) =>
              entrées.forEach((en) => {
                if (!en.isIntersecting) return;
                visibles?.unobserve(en.target);
                const l = lienInterne(en.target);
                if (l) précharger(l);
              })
            )
          : null;
      document.addEventListener('astro:page-load', () => {
        if (connexion()?.saveData === true) return;
        auRepos(() => {
          document.querySelectorAll('#menu a[href]').forEach((a) => visibles?.observe(a));
          if (connexion()?.effectiveType === '4g') document.querySelectorAll('main a[href]').forEach((a) => visibles?.observe(a));
        });
      });

      // Le chargeur du routeur (celui d'Astro, router.js : defaultLoader) lit la page gardée au lieu de
      // la retélécharger, puis fait la même suite. Au moindre doute (rien en mémoire, formulaire, page
      // d'avant un déploiement), c'est le sien qui travaille, comme avant.
      document.addEventListener('astro:before-preparation', (e) => {
        const url = e.to.origin + e.to.pathname + e.to.search;
        const entrée = pages.get(url);
        if (e.formData || !frais(entrée)) return;
        const origine = e.loader;
        e.loader = async () => {
          const html = await entrée.html;
          if (e.signal.aborted) return;
          const doc = html === null ? null : new DOMParser().parseFromString(html, 'text/html');
          doc?.querySelectorAll('noscript').forEach((n) => n.remove());
          if (!doc?.querySelector('[name="astro-view-transitions-enabled"]')) {
            pages.delete(url);
            return origine();
          }
          // Les feuilles de style de la nouvelle page, attendues avant le remplacement. Une qui n'existe
          // plus : la page gardée date d'avant un déploiement, on la refait.
          const manquantes = [...doc.querySelectorAll<HTMLLinkElement>('head link[rel=stylesheet]')].filter(
            (s) => !document.querySelector(`[data-astro-transition-persist="${s.getAttribute('data-astro-transition-persist')}"], link[rel=stylesheet][href="${s.getAttribute('href')}"]`)
          );
          const résultats = await Promise.all(
            manquantes.map(
              (s) =>
                new Promise<boolean>((fini) => {
                  const p = document.createElement('link');
                  p.rel = 'preload';
                  p.as = 'style';
                  p.href = s.getAttribute('href')!;
                  p.addEventListener('load', () => fini(true));
                  p.addEventListener('error', () => fini(false));
                  document.head.append(p);
                })
            )
          );
          if (e.signal.aborted) return;
          if (résultats.includes(false)) {
            pages.delete(url);
            return origine();
          }
          e.newDocument = doc;
        };
      });

      // --- Chargement en cours -----------------------------------------------------
      // Le lien cliqué reste allumé tout de suite (le menu reste ouvert jusqu'à l'arrivée de la page, l'œil
      // est dessus) ; passé 150 ms, la barre du haut s'allume : une page préchargée arrive avant et ne
      // montre rien. Ni voile noir ni état sur <html> (le routeur en recopie les attributs).
      let attente = 0;
      let cliqué: Element | null = null;
      function finirAttente() {
        clearTimeout(attente);
        document.querySelector('.js-chargement')?.removeAttribute('data-actif');
        cliqué?.removeAttribute('data-en-cours');
        cliqué = null;
        document.querySelector('main')?.removeAttribute('aria-busy');
      }
      document.addEventListener('astro:before-preparation', (e) => {
        finirAttente();
        if (e.sourceElement instanceof HTMLAnchorElement) {
          cliqué = e.sourceElement;
          cliqué.setAttribute('data-en-cours', '');
        }
        document.querySelector('main')?.setAttribute('aria-busy', 'true');
        attente = window.setTimeout(() => document.querySelector('.js-chargement')?.setAttribute('data-actif', ''), 150);
        // Un second clic annule le premier : sa fin éteint ce qui restait allumé.
        e.signal.addEventListener('abort', finirAttente, { once: true });
      });
      document.addEventListener('astro:after-swap', finirAttente);

      // --- Apparition en cascade ------------------------------------------------
      // Chaque bloc glisse en place, l'un après l'autre, à chaque page. Les
      // blocs portent data-cascade : titres, lignes des listes, sections,
      // pastilles, vignettes de la galerie.
      document.addEventListener('astro:page-load', () => {
        if (mouvementRéduit.matches) return;
        // Au chargement à froid, le script en ligne sous <main> les a déjà lancés.
        document.querySelectorAll<HTMLElement>('main [data-cascade]:not(.animate-rise)').forEach((el, i) => {
          el.classList.add('animate-rise');
          // Le décalage en style en ligne : il l'emporte sur le raccourci animation de la classe.
          el.style.animationDelay = `${Math.min(0.1 + i * 0.07, 0.9)}s`;
        });
      });

      // --- Défilement : Découvrir s'efface, la grande photo se floute ----------
      // Le voile de l'en-tête est un besoin de lisibilité, pas un mouvement : il suit le défilement
      // même avec prefers-reduced-motion (la règle de site.css coupe alors son fondu).
      const voilerEntête = () => document.querySelector('.js-entete')?.classList.toggle('est-parti', scrollY > 40);
      document.addEventListener('astro:page-load', voilerEntête);
      let enAttente = false;
      addEventListener(
        'scroll',
        () => {
          if (enAttente) return;
          enAttente = true;
          requestAnimationFrame(() => {
            enAttente = false;
            voilerEntête();
            if (mouvementRéduit.matches) return;
            document.querySelectorAll('.js-hint').forEach((h) => h.classList.toggle('est-parti', scrollY > 40));
            const héros = document.querySelector<HTMLElement>('.js-hero');
            if (!héros) return;
            const p = Math.min(1, Math.max(0, (scrollY / innerHeight - 0.5) * 2));
            héros.style.filter = p ? `blur(${(p * 2).toFixed(2)}rem)` : '';
          });
        },
        { passive: true }
      );

      // Découvrir : défile jusqu'à la première section sous la photo.
      document.addEventListener('click', (e) => {
        if (!(e.target as Element).closest('.js-hint')) return;
        document.querySelector('[data-tete] + *')?.scrollIntoView({ behavior: mouvementRéduit.matches ? 'auto' : 'smooth' });
      });
    </script>
  </body>
</html>
