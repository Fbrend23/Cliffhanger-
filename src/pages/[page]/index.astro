---
// Les deux pages légales, /mentions-legales/ et /confidentialite/. Elles ne
// sont générées que si les réglages du CMS donnent toutes les informations
// légales (`légal()`) : sinon aucune page, et le footer n'en parle pas.
import Base from '../../layouts/Base.astro';
import Intitule from '../../components/Intitule.astro';
import LienRetour from '../../components/LienRetour.astro';
import PageListe from '../../components/PageListe.astro';
import FilAriane from '../../components/FilAriane.astro';
import Footer from '../../components/Footer.astro';
import Section from '../../components/Section.astro';
import TexteRiche from '../../components/TexteRiche.astro';
import TitrePage from '../../components/TitrePage.astro';
import { contenu } from '../../lib/contenu.js';
import { T } from '../../lib/textes.js';
import { légalÉchappé } from '../../lib/legal.js';
import { filAriane } from '../../lib/seo.js';

export async function getStaticPaths() {
  const { légal } = await contenu();
  if (!légal) return [];
  const l = légalÉchappé(légal);
  return [
    {
      params: { page: 'mentions-legales' },
      props: { titre: T.mentionsLégales, description: T.descriptionMentionsLégales, sections: T.sectionsMentionsLégales(l) },
    },
    {
      params: { page: 'confidentialite' },
      props: { titre: T.confidentialité, description: T.descriptionConfidentialité, sections: T.sectionsConfidentialité(l) },
    },
  ];
}

const { titre, description, sections } = Astro.props;

const jsonLd = filAriane([
  { nom: T.accueil, url: new URL('/', Astro.site).toString() },
  { nom: titre, url: new URL(Astro.url.pathname, Astro.site).toString() },
]);
---

<Base title={titre} description={description} jsonLd={jsonLd}>
  <PageListe>
    <div class="mx-auto w-full max-w-4xl px-gouttiere">
      <LienRetour href="/" texte={T.retourAccueil} />
      <FilAriane chemin={[{ nom: T.accueil, href: '/' }, { nom: titre }]} />
      <TitrePage texte={titre} />
    </div>
    {
      sections.map((s: { titre: string; html: string }) => (
        <Section>
          <Intitule texte={s.titre} />
          <TexteRiche html={s.html} />
        </Section>
      ))
    }
    <Footer />
  </PageListe>
</Base>
