---
// Contact : l'adresse et les réseaux des réglages, sur un fond assombri. Un
// champ vide n'est pas rendu : pas d'Instagram, pas de bouton.
import Base from '../../layouts/Base.astro';
import TitrePage from '../../components/TitrePage.astro';
import Fond from '../../components/Fond.astro';
import Pied from '../../components/Pied.astro';
import { contenu } from '../../lib/contenu.js';
import { herosPhoto } from '../../lib/images.js';
import { T } from '../../lib/textes.js';
import { tx } from '../../lib/typo.js';

const c = await contenu();
const r = c.reglages;
const fond = c.photo(r.fonds.contact);
const precharger = await herosPhoto(fond);
const réseaux = [
  { href: r.instagram, label: T.instagram },
  { href: r.facebook, label: T.facebook },
].filter((l) => l.href);
---

<Base title={T.contact} precharger={precharger}>
  <section class="contact">
    <Fond fond={fond} ton="voile" />
    <div class="contact__inner">
      <TitrePage texte={T.contact} />
      <p class="contact__lead" data-cascade set:html={tx(T.contactLead)} />
      {r.email && <p class="contact__mail" data-cascade><a href={`mailto:${r.email}`}>{r.email}</a></p>}
      {
        réseaux.length > 0 && (
          <div class="pills" data-cascade>
            {réseaux.map((l) => (
              <a class="pill ext" href={l.href} target="_blank" rel="noopener">
                {l.label}
                <span class="sr-only">{T.nouvelOnglet}</span>
              </a>
            ))}
          </div>
        )
      }
    </div>
    <Pied epingle />
  </section>
</Base>
