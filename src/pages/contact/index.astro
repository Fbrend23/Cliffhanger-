---
// Contact : l'adresse et les réseaux des réglages, sur un fond assombri. Un
// champ vide n'est pas rendu : pas d'Instagram, pas de bouton.
import Base from '../../layouts/Base.astro';
import PageCentree from '../../components/PageCentree.astro';
import Reseaux from '../../components/Reseaux.astro';
import { contenu } from '../../lib/contenu.js';
import { herosPhoto } from '../../lib/images.js';
import { T } from '../../lib/textes.js';

const c = await contenu();
const r = c.reglages;
const fond = c.photo(r.fonds.contact);
const precharger = await herosPhoto(fond);
const réseaux = [
  { href: r.instagram, label: T.instagram },
  { href: r.facebook, label: T.facebook },
];
---

<Base title={T.contact} description={T.descriptionContact} precharger={precharger}>
  <PageCentree fond={fond} titre={T.contact} chapeau={T.contactLead}>
    {r.email && (
      <p class="text-mail font-normal [word-break:break-word]" data-cascade>
        <a
          class="border-b border-front/40 transition-colors duration-250 hover:border-front focus-visible:border-front"
          href={`mailto:${r.email}`}
        >
          {r.email}
        </a>
      </p>
    )}
    <Reseaux class="justify-center" liens={réseaux} />
  </PageCentree>
</Base>
