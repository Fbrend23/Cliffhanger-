---
// L'agenda, Bruxelles seulement : les séries à venir (s'il y en a), dans
// l'ordre du calendrier, puis les passées, les plus récentes d'abord. Calculé
// au build ; la reconstruction de la nuit fait passer une date jouée. Une
// série à venir qui compte une date réservable mène au formulaire de la fiche.
import Base from '../../layouts/Base.astro';
import TitrePage from '../../components/TitrePage.astro';
import Fond from '../../components/Fond.astro';
import Intitule from '../../components/Intitule.astro';
import PageListe from '../../components/PageListe.astro';
import Pied from '../../components/Pied.astro';
import Section from '../../components/Section.astro';
import TableauDates from '../../components/TableauDates.astro';
import { contenu } from '../../lib/contenu.js';
import { aujourdhui, formatPlage, lieu, séries } from '../../lib/dates.js';
import { herosPhoto } from '../../lib/images.js';
import { T } from '../../lib/textes.js';
import { tx } from '../../lib/typo.js';

const c = await contenu();
const fond = c.photo(c.reglages.fonds.agenda);
const precharger = await herosPhoto(fond);

const belges = new Map(c.belges.map((s) => [s.slug, s]));
const toutes = séries(c.représentations.filter((r) => belges.has(r.spectacle)));
const maintenant = aujourdhui();
const àVenir = toutes.filter((s) => s.à >= maintenant).reverse();
const passées = toutes.filter((s) => s.à < maintenant);

// Une série se réserve si l'un de ses soirs, à venir, se réserve : même
// spectacle, même lieu, entre ses bornes.
const réservable = (s: (typeof toutes)[number]) =>
  c.représentations.some((r) => r.reservation && r.spectacle === s.spectacle && lieu(r) === s.lieu && r.day >= s.de && r.day <= s.à && r.day >= maintenant);

const lignes = (liste: typeof toutes) =>
  liste.map((s) => {
    const spectacle = belges.get(s.spectacle)!;
    const réserver = réservable(s) ? `<a class="lien-souligne" href="/spectacle/${spectacle.slug}/#reserver">${tx(T.réserver)}</a>` : '';
    return [
      { html: tx(formatPlage(s.de, s.à)) },
      { html: `<a href="/spectacle/${spectacle.slug}/">${tx(spectacle.title)}</a>`, titre: true },
      { html: [tx(s.lieu), réserver].filter(Boolean).join(' · ') },
    ];
  });
---

<Base title={T.agenda} precharger={precharger}>
  <PageListe>
    <Fond fond={fond} ton="sombre" />
    <div class="mx-auto w-full max-w-[96rem] px-gouttiere">
      <TitrePage texte={T.agenda} />
      {
        àVenir.length > 0 && (
          <Section nu>
            <Intitule texte={T.àVenir} />
            <TableauDates lignes={lignes(àVenir)} />
          </Section>
        )
      }
      {
        passées.length > 0 && (
          <Section nu>
            {àVenir.length > 0 && <Intitule texte={T.passées} />}
            <TableauDates lignes={lignes(passées)} />
          </Section>
        )
      }
    </div>
    <Pied />
  </PageListe>
</Base>
