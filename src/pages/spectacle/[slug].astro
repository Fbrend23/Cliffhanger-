---
// La fiche d'un spectacle belge. Un spectacle de la troupe de Montréal n'a
// pas de page à lui : il vit sur /montreal/.
import Base from '../../layouts/Base.astro';
import LienRetour from '../../components/LienRetour.astro';
import Pied from '../../components/Pied.astro';
import SectionsSpectacle from '../../components/SectionsSpectacle.astro';
import TeteDePage from '../../components/TeteDePage.astro';
import { contenu } from '../../lib/contenu.js';
import { cadrage, herosSpectacle, og } from '../../lib/images.js';
import { extrait, theaterEvent } from '../../lib/seo.js';
import { T } from '../../lib/textes.js';

export async function getStaticPaths() {
  const c = await contenu();
  return c.belges.map((s) => ({ params: { slug: s.slug }, props: { slug: s.slug } }));
}

const c = await contenu();
const s = c.belges.find((x) => x.slug === Astro.props.slug)!;
const img = await herosSpectacle(s);

// Une représentation, un TheaterEvent : l'affiche (sinon la grande photo)
// comme image, la même que celle des partages.
const url = new URL(Astro.url.pathname, Astro.site).toString();
const image = new URL(await og(s.poster ?? s.hero), Astro.site).toString();
const organisateur = { nom: c.reglages.site_title, url: new URL('/', Astro.site).toString() };
const jsonLd = c.représentationsDe(s.slug).map((r) => theaterEvent(s, r, { url, image, organisateur }));
---

<Base title={s.title} description={s.punch ?? extrait(s.text)} image={s.poster ?? s.hero} precharger={img} jsonLd={jsonLd.length ? jsonLd : null}>
  <article>
    <TeteDePage img={img} alt={s.title} style={cadrage(s.focal)} titre={s.title} sous={s.year} credit={s.credit} sansTraduction />
    <SectionsSpectacle spectacle={s} />
    <div class="mx-auto w-full max-w-4xl px-gouttiere"><LienRetour href="/spectacles/" texte={T.tousLesSpectacles} /></div>
    <Pied />
  </article>
</Base>
