---
// Montréal : le collectif-sœur, à part. C'est la seule page du site (avec le
// pied) où Montréal apparaît. La grande photo est celle du spectacle de la
// troupe de Montréal, dont les sections suivent le texte du collectif.
import Base from '../../layouts/Base.astro';
import Accroche from '../../components/Accroche.astro';
import Pied from '../../components/Pied.astro';
import Section from '../../components/Section.astro';
import SectionsSpectacle from '../../components/SectionsSpectacle.astro';
import TeteDePage from '../../components/TeteDePage.astro';
import TexteRiche from '../../components/TexteRiche.astro';
import { contenu } from '../../lib/contenu.js';
import { cadrage, herosSpectacle } from '../../lib/images.js';
import { extrait } from '../../lib/seo.js';
import { T } from '../../lib/textes.js';
import { tx } from '../../lib/typo.js';

const c = await contenu();
const m = c.montreal;
const s = c.montrealSpectacle;
const img = s ? await herosSpectacle(s) : null;
---

<Base title={T.montreal} description={m.lead ?? extrait(m.text)} image={s?.poster ?? s?.hero ?? null} precharger={img}>
  <article>
    <TeteDePage img={img} alt={s?.title ?? ''} style={cadrage(s?.focal)} titre={T.montreal} sous={m.sub} />
    {
      m.lead && (
        <Section>
          <Accroche texte={m.lead} />
        </Section>
      )
    }
    {
      m.text && (
        <Section>
          <TexteRiche html={m.text} justifie />
        </Section>
      )
    }
    {
      s && (
        <>
          <Section>
            <h2 class="titre text-titre opacity-75 [--o:.75]" data-cascade translate="no" set:html={tx(s.title)} />
            {s.year != null && <p class="mt-2 text-xl font-normal opacity-75">{s.year}</p>}
          </Section>
          <SectionsSpectacle spectacle={s} />
        </>
      )
    }
    <Pied />
  </article>
</Base>
