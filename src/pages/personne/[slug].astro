---
// La fiche d'une personne : ses projets (tous les spectacles, Montréal
// compris, les plus récents d'abord, avec ses rôles), puis sa biographie si
// elle existe. Toutes les personnes ont une fiche, invitées comprises.
import Base from '../../layouts/Base.astro';
import Intitule from '../../components/Intitule.astro';
import LienRetour from '../../components/LienRetour.astro';
import PageListe from '../../components/PageListe.astro';
import Pied from '../../components/Pied.astro';
import Section from '../../components/Section.astro';
import TableauDates from '../../components/TableauDates.astro';
import TexteRiche from '../../components/TexteRiche.astro';
import TitrePage from '../../components/TitrePage.astro';
import { adresseSpectacle, contenu } from '../../lib/contenu.js';
import { joindreFr, projetsDe } from '../../lib/generique.js';
import { extrait } from '../../lib/seo.js';
import { T } from '../../lib/textes.js';
import { tx } from '../../lib/typo.js';

export async function getStaticPaths() {
  const c = await contenu();
  return c.personnes.map((p) => ({ params: { slug: p.slug }, props: { slug: p.slug } }));
}

const c = await contenu();
const p = c.personne(Astro.props.slug)!;
const sesProjets = projetsDe(p.slug, c.spectacles, c.lignesParSpectacle);
const projets = sesProjets.map((x) => [
  { html: tx(x.spectacle.year ?? '') },
  { html: `<a href="${adresseSpectacle(x.spectacle)}">${tx(x.spectacle.title)}</a>`, titre: true },
  { html: tx(x.roles.join(', ')) },
]);
// Le début de sa biographie, sinon ses spectacles : chaque fiche a la sienne.
const description = extrait(p.bio) ?? T.descriptionPersonne(p.name, joindreFr(sesProjets.map((x) => x.spectacle.title)));
---

<Base title={p.name} description={description}>
  <PageListe>
    <div class="mx-auto w-full max-w-4xl px-gouttiere">
      <TitrePage texte={p.name} />
      {
        projets.length > 0 && (
          <Section nu>
            <Intitule texte={T.projets} />
            <TableauDates lignes={projets} />
          </Section>
        )
      }
      {
        p.bio && (
          <Section nu>
            <Intitule texte={T.biographie} />
            <TexteRiche html={p.bio} justifie />
          </Section>
        )
      }
      <LienRetour href="/compagnie/" texte={T.retourCompagnie} />
    </div>
    <Pied />
  </PageListe>
</Base>
