---
// L'accueil : la photo de fond des réglages, les titres des spectacles
// belges en grand, leur photo au survol. Pas de titre visible, un h1 caché.
import Base from '../layouts/Base.astro';
import Fond from '../components/Fond.astro';
import ListeSpectacles from '../components/ListeSpectacles.astro';
import Pied from '../components/Pied.astro';
import { contenu } from '../lib/contenu.js';
import { herosPhoto, og } from '../lib/images.js';
import { organisation, siteWeb } from '../lib/seo.js';
import { T } from '../lib/textes.js';
import { tx } from '../lib/typo.js';

const c = await contenu();
const fond = c.photo(c.reglages.fonds.accueil);
const precharger = await herosPhoto(fond);

// Le site et la compagnie pour les moteurs : son nom, son adresse, ses
// réseaux, son équipe (chacun vers sa fiche).
const r = c.reglages;
const imageOg = r.og_image ?? fond?.image ?? null;
const accueil = new URL('/', Astro.site).toString();
const jsonLd = [
  siteWeb({ nom: r.site_title, url: accueil }),
  organisation({
    nom: r.site_title,
    url: accueil,
    description: r.site_description,
    email: r.email,
    réseaux: [r.instagram, r.facebook],
    image: imageOg ? new URL(await og(imageOg), Astro.site).toString() : null,
    logo: new URL('/apple-touch-icon.png', Astro.site).toString(),
    membres: c.personnes.filter((p) => p.groupe === 'equipe').map((p) => ({ nom: p.name, url: new URL(`/personne/${p.slug}/`, Astro.site).toString() })),
  }),
];
---

<Base precharger={precharger} jsonLd={jsonLd}>
  <section class="relative isolate flex min-h-svh flex-col justify-end px-gouttiere pb-27">
    <h1 class="sr-only" set:html={tx(T.accueilH1)} />
    <Fond fond={fond} survol={c.belges} />
    <ListeSpectacles spectacles={c.belges} />
    <Pied epingle />
  </section>
</Base>
