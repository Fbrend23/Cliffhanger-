---
// La page introuvable, servie par Apache (ErrorDocument dans .htaccess) :
// sobre, sur le fond de l'accueil, avec le chemin du retour.
import Base from '../layouts/Base.astro';
import PageCentree from '../components/PageCentree.astro';
import Pastille from '../components/Pastille.astro';
import { contenu } from '../lib/contenu.js';
import { T } from '../lib/textes.js';
import { tx } from '../lib/typo.js';

const c = await contenu();
const fond = c.photo(c.reglages.fonds.accueil);
---

<Base title={T.introuvable}>
  <PageCentree fond={fond} titre={T.introuvable} chapeau={T.introuvableTexte}>
    <div class="mt-4 flex flex-wrap justify-center gap-3" data-cascade>
      <Pastille href="/"><Fragment set:html={tx(T.retourAccueil)} /></Pastille>
    </div>
  </PageCentree>
</Base>
