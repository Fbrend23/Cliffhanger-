---
// La grille de la galerie et sa visionneuse.
//
// La visionneuse est un <dialog> ouvert par showModal() : le navigateur y
// garde le focus et le ferme sur Échap, sans script. Le script ajoute les
// flèches (boutons et clavier), le balayage du doigt, la fermeture d'un clic
// à côté, et rend le focus à la vignette d'où l'on vient.
//
// La grande image n'est demandée qu'à l'ouverture : ses srcset (AVIF et WebP)
// attendent sur le bouton de la vignette, et le navigateur choisit format et
// taille. Le temps qu'elle arrive, la visionneuse montre la vignette déjà
// chargée, jamais une case vide ; ses deux voisines suivent, en priorité
// basse, pour que les flèches soient instantanées. Comme le portfolio
// (61e2bf7, 1de987e).
import Photo from './Photo.astro';
import { grande, vignetteGalerie } from '../lib/images.js';
import { T } from '../lib/textes.js';
import { tx, typographier } from '../lib/typo.js';

interface Props {
  photos: { id: string; caption: string; image: any; width: number | null; height: number | null; apercu: string }[];
}

const { photos } = Astro.props;
// Les flèches de la visionneuse, de part et d'autre de l'image.
const flèche = 'absolute top-1/2 min-h-11 min-w-11 -translate-y-1/2 p-4 text-[3rem] opacity-75';
const tuiles = await Promise.all(
  photos.map(async (p) => {
    const taille = { width: p.width, height: p.height };
    return { caption: p.caption, vignette: await vignetteGalerie(p.image, taille, p.apercu), grande: await grande(p.image, taille) };
  })
);
---

<div class="mt-respiration columns-[3_18rem] gap-x-4">
  {
    tuiles.map((t) => (
      <figure class="mb-4 break-inside-avoid" data-cascade>
        <button
          class="group js-vignette block w-full cursor-zoom-in"
          type="button"
          data-srcset={t.grande.srcset}
          data-avif={t.grande.avif}
          data-ratio={t.grande.width / t.grande.height}
          data-src={t.grande.src}
          data-sizes={t.grande.sizes}
          data-legende={typographier(t.caption)}
          aria-label={typographier(T.agrandir(t.caption))}
        >
          <Photo
            img={t.vignette}
            alt={t.caption}
            class="h-auto w-full animate-[fadein_.6s_ease_both] transition-opacity duration-250 group-hover:opacity-85 group-focus-visible:opacity-85"
          />
        </button>
        <figcaption class="px-1 py-[.35rem] text-xs opacity-75" set:html={tx(t.caption)} />
      </figure>
    ))
  }
</div>

<dialog
  class="js-visionneuse fixed inset-0 z-50 m-0 size-full max-h-none max-w-none touch-pan-y overscroll-contain bg-back/94 px-4 pt-14 pb-10 text-front backdrop:bg-transparent open:flex open:animate-[fadein_.3s_ease_both] open:items-center open:justify-center"
  aria-label={T.photoAgrandie}
>
  <button class="js-fermer absolute top-[calc(1rem+var(--safe-top))] right-4 rounded-[2rem] border border-front px-[.9rem] py-[.35rem]" type="button">{T.fermer}</button>
  <button class={`${flèche} left-0`} type="button" data-pas="-1" aria-label={T.photoPrécédente}>‹</button>
  <img class="max-h-full max-w-full object-contain" alt="" />
  <button class={`${flèche} right-0`} type="button" data-pas="1" aria-label={T.photoSuivante}>›</button>
  <p class="js-legende absolute inset-x-0 bottom-4 text-center text-sm opacity-75"></p>
</dialog>

<script>
  // Les textes restent dans le dictionnaire : le script l'importe, Vite le
  // met dans le paquet du navigateur.
  import { T } from '../lib/textes.js';

  document.addEventListener('astro:page-load', () => {
    const boîte = document.querySelector<HTMLDialogElement>('dialog.js-visionneuse');
    if (!boîte) return;
    const vignettes = [...document.querySelectorAll<HTMLButtonElement>('.js-vignette')];
    const classes = boîte.querySelector('img')?.className ?? '';
    const légende = boîte.querySelector<HTMLElement>('.js-legende')!;
    const économe = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData === true;
    let position = 0;
    let retour: HTMLElement | null = null;

    // La grande image d'une vignette, chargée une seule fois et décodée : une
    // promesse partagée par l'affichage et le préchargement des voisines.
    // Hors de la page, dans son propre <picture>, pour que le navigateur y
    // choisisse l'AVIF ; la source et les srcset sont posés avant le src,
    // sinon le petit WebP partirait d'abord. On attend `load` avant decode() :
    // sur WebKit, decode() d'une image détachée peut se résoudre trop tôt.
    // Le <picture> est gardé et affiché tel quel : l'<img> sortie de son
    // cadre referait son choix sans la source AVIF, et téléchargerait le WebP.
    const grandes = new Map<number, Promise<HTMLPictureElement>>();
    const charger = (i: number, priorité: 'high' | 'low') => {
      let p = grandes.get(i);
      if (!p) {
        const v = vignettes[i];
        const cadre = document.createElement('picture');
        cadre.className = 'contents';
        const img = document.createElement('img');
        if (v.dataset.avif) {
          const source = document.createElement('source');
          source.type = 'image/avif';
          source.sizes = v.dataset.sizes ?? '100vw';
          source.srcset = v.dataset.avif;
          cadre.append(source);
        }
        cadre.append(img);
        img.fetchPriority = priorité;
        img.decoding = 'async';
        img.sizes = v.dataset.sizes ?? '100vw';
        img.srcset = v.dataset.srcset ?? '';
        img.src = v.dataset.src ?? '';
        p = new Promise<void>((ok, échec) => {
          img.addEventListener('load', () => ok(), { once: true });
          img.addEventListener('error', () => échec(), { once: true });
        })
          .then(() => img.decode().catch(() => {}))
          .then(() => cadre);
        // Une image en échec pourra être redemandée.
        p.catch(() => grandes.delete(i));
        grandes.set(i, p);
      }
      return p;
    };

    // L'image affichée prend la place de la précédente dans la visionneuse,
    // à la taille de la photo contenue dans l'écran, qu'elle soit la vignette
    // ou la grande : sans ça, la vignette s'afficherait à sa petite taille
    // naturelle, puis sauterait. 6rem : les marges haute et basse de la
    // boîte (pt-14, pb-10), où vivent le bouton Fermer et la légende.
    let affichée: Element = boîte.querySelector('img')!;
    const afficher = (nœud: HTMLImageElement | HTMLPictureElement, alt: string, ratio: number) => {
      const img = nœud instanceof HTMLImageElement ? nœud : nœud.querySelector('img')!;
      img.className = classes;
      img.alt = alt;
      if (ratio) {
        img.style.aspectRatio = String(ratio);
        img.style.width = `min(100%, calc((100dvh - 6rem) * ${ratio}))`;
      }
      if (affichée !== nœud) affichée.replaceWith(nœud);
      affichée = nœud;
    };

    const montrer = () => {
      const i = position;
      const v = vignettes[i];
      const vignette = v.querySelector('img');
      const alt = vignette?.alt ?? '';
      const ratio = Number(v.dataset.ratio) || 0;
      légende.textContent = T.légendeVisionneuse(v.dataset.legende ?? '', i + 1, vignettes.length);
      // D'abord la vignette déjà chargée, agrandie : la photo est là tout de
      // suite, et se précise quand la grande arrive.
      if (vignette?.currentSrc) {
        const aperçu = new Image();
        aperçu.src = vignette.currentSrc;
        afficher(aperçu, alt, ratio);
      }
      charger(i, 'high')
        .then((cadre) => {
          if (position === i && boîte.open) afficher(cadre, alt, ratio);
        })
        .catch(() => {});
      if (!économe) for (const pas of [1, -1]) charger((i + pas + vignettes.length) % vignettes.length, 'low').catch(() => {});
    };
    const avancer = (pas: number) => {
      position = (position + pas + vignettes.length) % vignettes.length;
      montrer();
    };

    vignettes.forEach((v, i) =>
      v.addEventListener('click', () => {
        retour = v;
        position = i;
        montrer();
        boîte.showModal();
        boîte.querySelector<HTMLElement>('.js-fermer')?.focus();
      })
    );
    boîte.querySelector('.js-fermer')?.addEventListener('click', () => boîte.close());
    boîte.querySelectorAll<HTMLElement>('[data-pas]').forEach((b) => b.addEventListener('click', () => avancer(Number(b.dataset.pas))));
    // Un clic sur le fond (le dialogue lui-même, pas l'image ni un bouton) ferme.
    boîte.addEventListener('click', (e) => {
      if (e.target === boîte) boîte.close();
    });
    boîte.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') avancer(1);
      if (e.key === 'ArrowLeft') avancer(-1);
    });
    boîte.addEventListener('close', () => retour?.focus());

    // Le balayage : cinquante pixels décident.
    let x0: number | null = null;
    boîte.addEventListener('touchstart', (e) => (x0 = e.touches[0].clientX), { passive: true });
    boîte.addEventListener('touchend', (e) => {
      if (x0 === null) return;
      const dx = e.changedTouches[0].clientX - x0;
      if (Math.abs(dx) > 50) avancer(dx < 0 ? 1 : -1);
      x0 = null;
    });
  });
</script>
