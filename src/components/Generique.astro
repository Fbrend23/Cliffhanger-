---
// Le générique d'un spectacle : une ligne par rôle, les noms en liens vers
// les fiches, puis la durée. Les lignes viennent de lib/generique.js.
import { valeurLigne, type Ligne } from '../lib/generique.js';
import { T } from '../lib/textes.js';
import { tx } from '../lib/typo.js';

interface Props {
  lignes: Ligne[];
  personne: (slug: string) => { name: string } | null;
  duree?: string | null;
}

const { lignes, personne, duree = null } = Astro.props;

// Le lien d'une personne, et son personnage entre parenthèses. Un nom sans
// fiche (ou dont la fiche est dépubliée) reste un simple nom.
const nomHtml = (n: { slug: string | null; nom: string; personnage: string | null }) => {
  const p = n.slug ? personne(n.slug) : null;
  const affiché = p ? `<a class="lien-souligne" href="/personne/${n.slug}/">${tx(p.name)}</a>` : tx(n.nom);
  return n.personnage ? `${affiché} (${tx(n.personnage)})` : affiché;
};

const rendues = lignes.map((l) => ({ role: tx(`${l.role} :`), valeur: valeurLigne(l, nomHtml, tx) })).filter((l) => l.valeur);
---

<div class="grid gap-[.35rem] leading-normal">
  {rendues.map((l) => <p><b class="font-medium" set:html={l.role} /> <Fragment set:html={l.valeur} /></p>)}
  {duree && <p><b class="font-medium" set:html={tx(`${T.durée} :`)} /> <Fragment set:html={tx(duree)} /></p>}
</div>
