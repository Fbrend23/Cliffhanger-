# Le site est statique : Apache sert des fichiers, rien d'autre.
Options -Indexes
DirectoryIndex index.html

RewriteEngine On

# Une seule adresse : https://compagniecliffhanger.be, sans www. HSTS (posé
# par l'hébergeur) ne vaut qu'après une première visite en https ; sans ces
# règles, http:// et www. serviraient le site tels quels, en deux ou trois
# adresses pour une page, que les moteurs compteraient comme des doublons.
# Le nom est en dur, comme sur le portfolio : un autre nom pointé par erreur
# sur l'hébergement est redirigé lui aussi. Il doit rester celui de SITE_URL.
RewriteCond %{HTTP_HOST} !^compagniecliffhanger\.be$ [NC,OR]
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://compagniecliffhanger.be%{REQUEST_URI} [R=301,L]

<IfModule mod_headers.c>
  # Les fichiers de /_astro/ portent une empreinte dans leur nom : ils ne
  # changent jamais, on peut les garder un an. Les polices aussi, qui ne
  # bougent qu'avec le code. La vidéo et l'image du menu, et les icônes, une
  # semaine, comme les images du prototype (les icônes n'avaient aucun
  # en-tête : le navigateur les gardait au jugé).
  # Les pages, elles, changent à chaque déploiement : le navigateur les
  # redemande à chaque visite (l'ETag lui vaut un 304 quand rien n'a bougé).
  <FilesMatch "\.[0-9a-zA-Z_-]{6,}\.(css|js|webp|jpe?g|png|svg|avif)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^(menu(-poster)?\.(mp4|webp)|favicon\.png|apple-touch-icon\.png)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Le refus d'aspiration pour entraîner des modèles, pour les machines qui le
  # lisent (robots.txt le dit aux robots qui s'annoncent) : TDM-Reservation
  # est la réservation W3C (TDMRep) que le droit européen reconnaît ;
  # noai/noimageai n'est pas un standard, mais plusieurs collecteurs
  # l'honorent. Les moteurs ignorent ce qu'ils ne connaissent pas.
  Header always set TDM-Reservation "1"
  Header always set X-Robots-Tag "noai, noimageai"

  # Le peu qu'un site statique peut dire au navigateur. Pas de CSP : scripts
  # et styles sont en ligne dans les pages, il faudrait un hachage par script.
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

ErrorDocument 404 /404.html
