# Environnement, jamais commité. Les valeurs vivent dans les secrets GitHub,
# et les fichiers locaux ne sont là que pour le développement.
.env
.env.*
!.env.example

# Build
dist/
# Vidéo du menu rapatriée du CMS au build (loader des réglages)
public/media/
.astro/

# Dépendances
node_modules/

# Originaux rapatriés du CMS au build, et leur manifeste. Reconstruit à la
# demande : un fichier absent ou modifié est retéléchargé, le reste ne l'est pas.
.cache/

# Système
.DS_Store
Thumbs.db
/private
