{
  "name": "compagnie-cliffhanger",
  "private": true,
  "type": "module",
  "description": "Site de la Compagnie Cliffhanger, théâtre à Bruxelles : site statique alimenté par Directus au build",
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "node --test test/*.test.js",
    "test:dist": "node --test test/site-construit.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.2",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^1.7.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  }
